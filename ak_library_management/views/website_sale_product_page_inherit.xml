<odoo>
    <data>
        <template id="ak_library_management.add_button" inherit_id="website_sale.product">
            <xpath expr="//div[@id='o_product_terms_and_share']" position="before">
                <a t-attf-href="/download_images/{{ slug(product)}}">
                    <button type="button" t-if="product.image_1920 or product.product_template_image_ids" class="btn btn-primary" >
                        Download image
                    </button>
                </a>
                <hr>
                </hr>
            </xpath>
        </template>
    </data>
</odoo>