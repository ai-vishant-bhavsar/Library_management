<odoo>
    <data>
        <record id="mail_template_book_return_confirmation" model="mail.template">
            <field name="name">Book Return Confirmation</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="subject">Confirmation: Book Return Successful</field>
            <field name="email_from">${object.company_id.email or 'info@example.com'}</field>
            <field name="email_to">${object.customer_id.email}</field>
            <field name="body_html">
                <![CDATA[
                <p>Dear ${object.customer_id.name},</p>
                <p>We confirm that your borrowed books have been successfully returned.</p>
                <p>Thank you for using our library services!</p>
                ]]>
            </field>
        </record>
    </data>
</odoo>