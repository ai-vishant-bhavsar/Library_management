<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List view library -->
        <record id="view_library_library_list" model="ir.ui.view">
            <field name="name">library.library.list</field>
            <field name="model">library.library</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="location"/>
                    <field name="capacity"/>
                </list>
            </field>
        </record>
        <!-- Form view library -->
        <record id="view_library_library_form" model="ir.ui.view">
            <field name="name">library.library.form</field>
            <field name="model">library.library</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="capacity"/>
                            <field name="notes"/>
                        </group>
                        <notebook>
                            <page string="Books">
                                <field name="product_id" domain="[('is_library_book','=','True')]">
                                    <list>
                                        <field name="name"/>
                                        <field name="author"/>
                                        <field name="barcode"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Library action -->
        <record id="action_library_library" model="ir.actions.act_window">
            <field name="name">Libraries</field>
            <field name="res_model">library.library</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>