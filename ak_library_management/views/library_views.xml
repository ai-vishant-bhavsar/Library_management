<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List view library -->
        <record id="view_library_library_list" model="ir.ui.view">
            <field name="name">library.library.list</field>
            <field name="model">library.library</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="location"/>
                    <field name="capacity"/>
                </list>
            </field>
        </record>
        <!-- Form view library -->
        <record id="view_library_library_form" model="ir.ui.view">
            <field name="name">library.library.form</field>
            <field name="model">library.library</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button"
                                    type="object"
                                    icon="fa-book"
                                    name="action_view_borrowed_books">
                                <field name="borrowed_book_count" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="location"/>
                            <field name="capacity"/>
                            <field name="notes"/>
                        </group>
                        <notebook>
                            <page string="Books">
                                <field name="book_ids" domain="[('is_library_book','=','True')]" options="{'create': false}">
                                    <list editable="top">
                                        <field name="default_code" string="Reference ID" readonly="true"/>
                                        <field name="name" readonly="true"/>
                                        <field name="author" readonly="true"/>
                                        <field name="state" readonly="true"/>
                                        <field name="barcode" readonly="true"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Library action -->
        <record id="action_library_library" model="ir.actions.act_window">
            <field name="name">Libraries</field>
            <field name="res_model">library.library</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>