<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="contact_kanban_page" name="Contact Kanban Page">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2 class="text-center">Contacts</h2>
                <div class="row">
                    <t t-foreach="contacts" t-as="contact">
                        <t t-if="not contact.is_company">
                            <div class="col-md-4">
                                <a t-attf-href="/contacts/{{ slug(contact)}}">
                                    <div class="card shadow-sm p-3 mb-3 text-center">
                                        <t t-if="contact.image_1920">
                                            <img t-att-src="'data:image/png;base64,%s' % contact.image_1920.decode()"
                                                 class="card-img-top rounded-circle"
                                                 style="width: 100px; height: 100px; object-fit: cover; margin: auto;"/>
                                        </t>
                                        <t t-else="not contact.image_1920">
                                            <img t-att-src=""
                                                 class="card-img-top rounded-circle"
                                                 style="width: 100px; height: 100px; object-fit: cover; margin: auto;"/>
                                        </t>
                                        <h5 class="mt-3">
                                            <t t-out="contact.name"/>
                                        </h5>
                                        <p>
                                            <t t-out="contact.email or 'No Email'"/>
                                        </p>
                                        <p>
                                            <t t-if="contact.is_company">
                                                <spna>Company</spna>
                                            </t>
                                        </p>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </t>
                </div>
                <hr></hr>
                <h2 class="text-center">Companies</h2>
                <div class="row">
                    <t t-foreach="contacts" t-as="contact">
                        <t t-if="contact.is_company">
                            <div class="col-md-4">
                                <a t-attf-href="/contacts/{{ slug(contact)}}">
                                    <div class="card shadow-sm p-3 mb-3 text-center">
                                        <t t-if="contact.image_1920">
                                            <img t-att-src="'data:image/png;base64,%s' % contact.image_1920.decode()"
                                                 class="card-img-top rounded-circle"
                                                 style="width: 100px; height: 100px; object-fit: cover; margin: auto;"/>
                                        </t>
                                        <t t-else="not contact.image_1920">
                                            <img t-att-src=""
                                                 class="card-img-top rounded-circle"
                                                 style="width: 100px; height: 100px; object-fit: cover; margin: auto;"/>
                                        </t>
                                        <h5 class="mt-3">
                                            <t t-out="contact.name"/>
                                        </h5>
                                        <p>
                                            <t t-out="contact.email or 'No Email'"/>
                                        </p>
                                        <p>
                                            <t t-if="contact.is_company">
                                                <spna>Company</spna>
                                            </t>
                                        </p>
                                    </div>
                                </a>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>