<odoo>
    <data>
       <record id="mail_template_book_return_reminder" model="mail.template">
            <field name="name">Book Return Reminder</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="subject">Reminder: Return Your Borrowed Books</field>
            <field name="email_from">${object.company_id.email or 'info@example.com'}</field>
            <field name="email_to">${object.customer_id.email}</field>
            <field name="body_html">
                <![CDATA[
                <p>Dear ${object.customer_id.name},</p>
                <p>This is a friendly reminder that you need to return your borrowed books by ${object.borrow_end_date}.</p>
                <p>Borrowed Books:</p>
                <ul>
                    <t t-foreach="object.book_ids" t-as="book">
                        <li><t t-esc="book.name"/></li>
                    </t>
                </ul>
                <p>Thank you for using our library services!</p>
                ]]>
            </field>
        </record>
    </data>
</odoo>