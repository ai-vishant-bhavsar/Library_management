<odoo>
    <template id="contact_detail_page" name="Contact Detail Page">
        <t t-call="website.layout">
            <div class="container mt-5">
                <a href="/contacts" class="btn btn-secondary mb-3">← Back to Contacts</a>
                <div class="card p-4 shadow-sm">
                    <div class="row">
                        <div class="col-md-4 text-center">
                            <t t-if="contact.image_1920">
                                <img t-att-src="'data:image/png;base64,%s' % contact.image_1920.decode()"
                                     t-alt="no image"
                                     class="rounded-circle shadow"
                                     style="width: 150px; height: 150px; object-fit: cover;"/>
                            </t>
                            <t t-else="not contact.image_1920">
                                <img t-att-src=""
                                     class="rounded-circle shadow"
                                     style="width: 150px; height: 150px; object-fit: cover;"/>
                            </t>
                        </div>
                        <div class="col-md-8">
                            <h2>
                                <t t-out="contact.name"/>
                            </h2>
                            <p>
                                <strong>Email:</strong>
                                <t t-out="contact.email or 'No Email'"/>
                            </p>
                            <p>
                                <strong>Phone:</strong>
                                <t t-out="contact.phone or 'No Phone'"/>
                            </p>
                            <p>
                                <strong>Company:</strong>
                                <t t-out="contact.company_name or 'No Company'"/>
                            </p>
                            <p>
                            	<strong>Address:</strong>
                            	<t t-out="contact.street or ''"/>
                            	<t t-if="contact.city">
                            	    <t>,</t>
                            	    <t t-out="contact.city"/>
                            	</t>
                            	<t t-if="contact.state_id.name">
                            	    <t>,</t>
                            	    <t t-out="contact.state_id.name"/>
                            	</t>
                            	<t t-if="contact.country_id.name">
                            	    <t>,</t>
                            	    <t t-out="contact.country_id.name"/>
                            	</t>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>
