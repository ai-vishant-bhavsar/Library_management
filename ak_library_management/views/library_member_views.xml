<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- List view library members -->
        <record id="view_library_member_tree" model="ir.ui.view">
            <field name="name">library.member.tree</field>
            <field name="model">library.member</field>
            <field name="arch" type="xml">
                <list name="Members List">
                    <field name="membership_no"/>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="phone"/>
                </list>
            </field>
        </record>
        <!-- Form view library member -->
        <record id="view_library_member_form" model="ir.ui.view">
            <field name="name">library.member.form</field>
            <field name="model">library.member</field>
            <field name="arch" type="xml">
                <form name="Member details form">
                    <sheet>
                        <group>
                            <group>
                                <field name="membership_no" string="Membership ID"/>
                                <field name="name"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="membership_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!-- Library member action -->
        <record id="action_library_member" model="ir.actions.act_window">
            <field name="name">Members</field>
            <field name="res_model">library.member</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>