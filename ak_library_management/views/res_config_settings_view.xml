<odoo>
    <record id="view_library_config_settings" model="ir.ui.view">
        <field name="name">library.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add a new section under General Settings -->
            <xpath expr="//form" position="inside">
                <app string="Library" data-string="Library" name="library_management">
                    <block title="Set Borrow Limit" name="borrow_setting_container">
                        <setting id="library_borrow_limit">
                            <field name="borrow_limit" groups="ak_library_management.group_library_admin"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
