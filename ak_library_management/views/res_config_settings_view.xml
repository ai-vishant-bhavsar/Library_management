<odoo>
    <record id="view_library_config_settings" model="ir.ui.view">
        <field name="name">library.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add a new section under General Settings -->
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Library Management" string="Library Management">
                    <h2>Library Management</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <field name="borrow_limit"/>
                                <div class="text-muted">Maximum books a member can borrow at a time.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
