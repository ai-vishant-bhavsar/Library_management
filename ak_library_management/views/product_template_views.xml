<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- This is the inheritance to the product template and add it into library management system -->
        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="readonly">sale_ok</attribute>
                </xpath>
                <xpath expr="//button[@name='action_open_label_layout']" position="after">
                    <button name="action_mark_as_borrowed" type="object" string="Mark as Borrowed"
                            class="oe_stat_button btn-primary"
                            invisible="not state == 'available'"/>
                    <button name="action_mark_as_available" type="object" string="Mark as Available"
                            class="oe_stat_button btn-primary"
                            invisible="not state == 'borrowed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,borrowed,reserved"/>
                    <button name="action_borrow_books" type="object" string="Borrow Books"
                            class="oe_highlight"/>
                </xpath>
                <xpath expr="//page[@name='general_information']" position="after">
                    <page string="Book details">
                        <group>
                            <group>
                                <field name="bulk_upload_book" readonly="1"/>
                                <field name="is_library_book" required="sale_ok and is_library_book"/>
                                <field name="author" required="sale_ok and is_library_book"/>
                                <field name="publisher" required="sale_ok and is_library_book"/>
                                <field name="edition" required="sale_ok and is_library_book"/>
                            </group>
                            <group>
                                <field name="library_id"/>
                                <field name="barcode" postion="move" string="ISBN Number"
                                       required="sale_ok and is_library_book"/>
                                <field name="published_date" required="sale_ok and is_library_book"/>
                                <field name="pages" required="sale_ok and is_library_book"/>
                                <field name="available" readonly="1"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <!-- This action is to show only Library books from the product-->
        <record id="stock.product_template_action_product" model="ir.actions.act_window">
            <field name="name">Books</field>
            <field name="domain">[('is_library_book', '=', True)]</field>
        </record>
    </data>
</odoo>