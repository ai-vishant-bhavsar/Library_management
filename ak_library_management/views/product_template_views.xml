<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- This is the inheritance to the product template and add it into library management system -->
        <record id="product_template_form_view" model="ir.ui.view">
            <field name="name">product.template.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="readonly">sale_ok</attribute>
                </xpath>
                <xpath expr="//button[@name='action_open_label_layout']" position="after">
                    <div class="oe_button_box" name="buttons">
                        <button name="action_mark_as_borrowed" type="object" string="Mark as Borrowed"
                            class="oe_stat_button btn-primary"
                            invisible="not state == 'available'"/>
                        <button name="action_mark_as_available" type="object" string="Mark as Available"
                            class="oe_stat_button btn-primary"
                            invisible="not state == 'borrowed'"/>
                    </div>
                </xpath>
                <xpath expr="//page[@name='general_information']" position="after">
                    <page string="Book details">
                        <form>
                            <header>
                                <field name="state" widget="statusbar" readonly="1"/>
                            </header>
                            <sheet>
                                <group>
                                    <group>
                                        <field name="is_library_book" required="sale_ok"/>
                                        <field name="author" required="sale_ok"/>
                                        <field name="publisher" required="sale_ok"/>
                                        <field name="edition" required="sale_ok"/>
                                    </group>
                                    <group>
                                        <field name="barcode" postion="move" string="ISBN Number" required="sale_ok"/>
                                        <field name="published_data" required="sale_ok"/>
                                        <field name="pages" required="sale_ok"/>
                                        <field name="available" required="sale_ok"/>
                                    </group>
                                </group>
                            </sheet>
                        </form>
                    </page>
                </xpath>
            </field>
        </record>

