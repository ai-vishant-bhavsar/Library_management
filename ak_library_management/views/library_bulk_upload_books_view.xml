<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- This is Tree view of bulk upload book -->
        <record id="library_bulk_upload_books_list" model="ir.ui.view">
            <field name="name">Bulk upload books.list</field>
            <field name="model">library.bulk.upload.books</field>
            <field name="arch" type="xml">
                <list>
                    <field name="book_names"/>
                </list>
            </field>
        </record>
        <!--This is a Form view for the inserting bulk records of books-->
        <record id="library_bulk_upload_books_form" model="ir.ui.view">
            <field name="name">Bulk upload books</field>
            <field name="model">library.bulk.upload.books</field>
            <field name="arch" type="xml">
                <form string="Bulk upload books">
                    <header>
                        <button name="create_products"
                                string="Create Products"
                                type="object"
                                class="oe_stat_button btn-primary"
                                />
                        <button name="revert_changes"
                                string="Revert Changes"
                                type="object"
                                class="oe_stat_button btn-primary"
                                invisible="bulk_books_count == 0" />
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box" position="inside">
                            <button class="oe_stat_button" type="object" name="bulk_books" icon="fa-book">
                                <field name="bulk_books_count" string="Product Count" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <field name="book_names"/>
                            <field name="author_id" required="True"/>
                            <field name="categories" default="Science friction"/>
                            <field name="price"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <!--this action for displaying the list and form view of the multiple books-->
        <record id="action_library_bulk_upload_books" model="ir.actions.act_window">
            <field name="name">Bulk Upload Books</field>
            <field name="res_model">library.bulk.upload.books</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>