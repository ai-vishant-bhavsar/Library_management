<odoo>
    <data>
        <record id="add_field_product_supplier_inherit" model="ir.ui.view">
            <field name="name">add.field.product.template.supplier.form.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='seller_ids']" position="replace">
                    <field name="seller_ids_custom"
                           context="{'default_product_tmpl_id': id, 'product_template_invisible_variant': True, 'list_view_ref':'purchase.product_supplierinfo_tree_view2'}"
                           nolabel="1" invisible="not vendor_of_variants and product_variant_count &gt; 1"
                           readonly="product_variant_count &gt; 1"/>
                </xpath>
                <xpath expr="//field[@name='variant_seller_ids']" position="replace">
                    <field name="variant_seller_ids_custom"
                           context="{'default_product_tmpl_id': id, 'product_template_invisible_variant': True, 'list_view_ref':'purchase.product_supplierinfo_tree_view2'}"
                           nolabel="1" invisible="not vendor_of_variants and product_variant_count &gt; 1"
                           readonly="product_variant_count &gt; 1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>