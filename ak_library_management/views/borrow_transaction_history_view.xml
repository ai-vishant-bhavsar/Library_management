<odoo>
    <!-- Search View -->
    <record id="view_borrow_transaction_search" model="ir.ui.view">
        <field name="name">borrow.transaction.history.search</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_id"/>
                <field name="books"/>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_borrow_transaction_tree" model="ir.ui.view">
        <field name="name">borrow.transaction.history.tree</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="borrow_start_date"/>
                <field name="borrow_end_date"/>
                <field name="deposit_amount"
                       invisible="not customer_id.is_member"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_borrow_transaction_form" model="ir.ui.view">
        <field name="name">borrow.transaction.history.form</field>
        <field name="model">borrow.transaction.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="books" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="borrow_start_date"/>
                            <field name="borrow_end_date"/>
                            <field name="deposit_amount"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for borrow transaction history -->
    <record id="action_borrow_transaction_history" model="ir.actions.act_window">
        <field name="name">Borrow Transactions</field>
        <field name="res_model">borrow.transaction.history</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>