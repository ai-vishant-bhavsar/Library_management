<odoo>
    <data>
        <record id="view_borrow_transaction_history_search_view" model="ir.ui.view">
            <field name="name">borrow.transaction.history.search.view</field>
            <field name="model">borrow.transaction.history</field>
            <field name="arch" type="xml">
                <search string="Borrow transaction history">
                    <field name="customer_id"/>
                </search>
            </field>
        </record>
        <record id="view_borrow_transaction_history_list" model="ir.ui.view">
            <field name="name">borrow.transaction.history.tree</field>
            <field name="model">borrow.transaction.history</field>
            <field name="arch" type="xml">
                <list name="Borrow transaction history">
                    <field name="customer_id"/>
                    <field name="deposit_amount"/>
                </list>
            </field>
        </record>
        <record id="view_borrowed_transaction_history_form" model="ir.ui.view">
            <field name="name">borrow.transaction.history.form</field>
            <field name="model">borrow.transaction.history</field>
            <field name="arch" type="xml">
                <form name="Borrow transaction history">
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="borrow_start_date"/>
                            <field name="borrow_end_date" options="{'datepicker':{'minDate': 'borrow_statr_date'}}"/>
                            <field name="deposit_amount"/>
                        </group>
                        <group>
                            <field name="books"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>
        <record id="action_borrow_transaction_history" model="ir.actions.act_window">
            <field name="name">Borrow transaction history</field>
            <field name="res_model">borrow.transaction.history</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>