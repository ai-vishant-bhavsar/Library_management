<odoo>
    <template id="customer_page" name="Customer Fetch Page">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2>Fetch Customer Details</h2>
                <div class="form-group">
                    <label for="customer_email">Enter Email:</label>
                    <input type="email" id="customer_email" class="form-control" placeholder="Enter customer email"/>
                </div>
                <button id="fetch_customer" class="btn btn-primary mt-2">Fetch Details</button>

                <div id="customer_info" class="mt-3"/>
            </div>
        </t>
    </template>
</odoo>