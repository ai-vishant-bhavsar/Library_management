<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- This view is inherited to add 2 buttons and change the condition of 1 button -->
        <record id="view_order_form" model="ir.ui.view">
            <field name="name">sale.order.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- This is the changed condition of existing button-->
                <xpath expr="//button[@name='action_confirm'][2]" position="attributes">
                    <attribute name="invisible">approval_needed and not approved_by_manager</attribute>
                </xpath>
                <!--In this I have added 2 new button named Approve and Reject-->
                <xpath expr="//button[@name='action_draft']" position="after">
                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            invisible="not approval_needed"
                            groups="base.group_system"/>
                    <button name="action_cancel"
                            string="Reject"
                            type="object"
                            invisible="not approval_needed"/>
                </xpath>
                <!-- In this I have add domain to show only book products -->
                <xpath expr="//field[@name='product_template_id']" position="attributes">
                    <attribute name="domain">[('sale_ok', '=', True),('is_library_book', '=', True)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
