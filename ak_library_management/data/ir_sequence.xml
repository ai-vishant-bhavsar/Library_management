<odoo>
    <data noupdate="1">
        <!-- Sequence for Book Reference -->
        <record id="seq_library_book_reference" model="ir.sequence">
            <field name="name">Library Book Reference</field>
            <field name="code">product.template</field>
            <field name="prefix">BOOK-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <!-- Sequence for Membership ID -->
        <record id="seq_library_member_id" model="ir.sequence">
            <field name="name">Library Member ID</field>
            <field name="code">library.member.id</field>
            <field name="prefix">MEM-%(year)s-%(month)s-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>