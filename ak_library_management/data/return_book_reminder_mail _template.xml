<odoo>
    <data noupdate="1">
        <record id="library_return_reminder_email_template" model="mail.template">
            <field name="name">Book Return Reminder</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="subject">Reminder: Book Return Due Soon</field>
            <field name="email_from">${(object.company_id.email or 'noreply@yourlibrary.com')}</field>
            <field name="email_to">${(object.customer_id.email)}</field>
            <field name="body_html"><![CDATA[
                <p>Dear ${object.customer_id.name},</p>
                <p>This is a friendly reminder that the book <strong>${object.book_id.name}</strong> is due for return on <strong>${object.return_date}</strong>.</p>
                <p>Please return it on time to avoid penalties.</p>
                <p>Thank you!</p>
            ]]></field>
        </record>
    </data>
</odoo>
