<odoo>
    <data noupdate="1">
        <record id="library_return_reminder_email_template" model="mail.template">
            <field name="name">Book Return Reminder</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="subject">Reminder: Book Return Due Soon</field>
            <field name="email_from">{{ user.email_formatted or 'noreply@yourlibrary.com' }}</field>
            <field name="email_to">${{ object.customer_id.id }}</field>
            <field name="body_html" type="html">
                <div style="margin: 1.5px; padding: 1.5px;">
                    <p style="margin: 1.5px; padding: 1.5px; font-size: 12px;">
                        Dear,
                        <t t-out="object.customer_id.name"/>
                        <br/>
                        <p style="font-weight: bold">Title:
                            <t t-out="[book.name for book in object.books]"/>
                        </p>f
                        <br/>
                        Your book Due Date <is>Q</is>
                        <t t-out="object.borrow_end_date"/>
                        <br />
                        so please returned the above books before Due Date.
                        <br/>
                        Thank You
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
