<odoo>
    <data noupdate="1">
        <record id="ir_cron_library_return_reminder" model="ir.cron">
            <field name="name">Library Book Return Reminder</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="state">code</field>
            <field name="code">model.send_return_reminder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <!--borrow transaction history overdue schedule action-->
        <record id="ir_cron_overdue_borrow_transaction_history" model="ir.cron">
            <field name="name">Borrow Book overdue</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="state">code</field>
            <field name="code">model._schedule_overdue_books()</field>
            <field name='interval_number'>1</field>
            <field name='interval_type'>weeks</field>
            <field name="active" eval="True"/>
        </record>
        <!--borrow transaction history change book status server action-->
        <record id="ir_actions_borrow_transaction_history" model="ir.actions.server">
            <field name="name">Change Book state</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="binding_model_id" ref="model_borrow_transaction_history"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">model.action_change_borrowed_book_state()</field>
        </record>
        <!--borrow transaction history server action-->
        <record id="server_actions_borrow_transaction_history" model="ir.actions.server">
            <field name="name">Due Date Check</field>
            <field name="model_id" ref="model_borrow_transaction_history"/>
            <field name="state">code</field>
            <field name="code">record.action_overdue_borrowed_books()</field>
        </record>
    </data>
</odoo>
