<odoo>
    <data>
        <record id="view_warning_wizard" model="ir.ui.view">
            <field name="name">warning.wizard.form</field>
            <field name="model">warning.wizard</field>
            <field name="arch" type="xml">
                <form string="Validation Wizard">
                    <group>
                        <field name="message" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Continue" type="object" name="action_continue" class="oe_highlight"/>
                        <button string="Cancel" type="object" name="action_cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>