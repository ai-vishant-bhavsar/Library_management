<odoo>
    <data>
        <record id="view_borrow_transaction_wizard_form" model="ir.ui.view">
            <field name="name">borrow.transaction.history.form</field>
            <field name="model">borrow.transaction.history.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="customer_id"/>
                                <field name="books" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="borrow_start_date"/>
                                <field name="borrow_end_date"/>
                                <field name="deposit_amount" invisible="is_member"/>
                            </group>
                        </group>
                    </sheet>
                    <footer>
                        <button class="btn-primary"
                                name="action_confirm"
                                type="object"
                                string="Confirm"/>
                        <button string="Discard" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>