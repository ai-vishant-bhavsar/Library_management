<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_borrow_transaction_warning_wizard" model="ir.ui.view">
        <field name="name">borrow.transaction.warning.wizard.form</field>
        <field name="model">borrow.transaction.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Warning">
                <group>
                    <field name="message" readonly="1"/>
                </group>
                <footer>
                    <button name="action_continue" string="Continue" type="object" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>