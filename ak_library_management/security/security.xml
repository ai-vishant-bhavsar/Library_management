<odoo>
    <!--custom category-->
    <record id="library_category" model="ir.module.category">
        <field name="name">Library</field>
    </record>

    <!--custom sub category-->
    <record id="library_sub_category" model="ir.module.category">
        <field name="name">Library Users</field>
        <field name="parent_id" ref="ak_library_management.library_category"/>
    </record>

    <!--custom library worker group-->
    <record id="group_library_worker" model="res.groups">
        <field name="name">Worker</field>
        <field name="category_id" ref="ak_library_management.library_sub_category"/>
    </record>

    <!--custom library assistant group-->
    <record id="group_library_assistant" model="res.groups">
        <field name="name">Assistant</field>
        <field name="category_id" ref="ak_library_management.library_sub_category"/>
    </record>

    <!--custom library admin group-->
    <record id="group_library_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="ak_library_management.library_sub_category"/>
    </record>

    <!-- Prevent Library Assistants and Workers from deleting borrowed books -->
    <record id="rule_no_delete_borrowed_books" model="ir.rule">
        <field name="name">No Delete Borrowed Books</field>
        <field name="model_id" ref="model_product_template"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('state', '!=', 'borrowed')]</field>
        <field name="perm_unlink" eval="0"/>
        <field name="groups" eval="[(4, ref('group_library_assistant')), (4, ref('group_library_worker'))]"/>
    </record>

    <!-- Workers can only view active transactions -->
    <record id="rule_worker_view_active_transactions" model="ir.rule">
        <field name="name">Worker View Active Transactions</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="domain_force">[('is_active', '=', True)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="groups" eval="[(4, ref('group_library_worker'))]"/>
    </record>

    <!-- Assistants cannot delete transactions -->
    <record id="rule_assistant_no_delete_transactions" model="ir.rule">
        <field name="name">Assistant No Delete Transactions</field>
        <field name="model_id" ref="model_borrow_transaction_history"/>
        <field name="domain_force">[]</field>
        <field name="perm_unlink" eval="0"/>
        <field name="groups" eval="[(4, ref('group_library_assistant'))]"/>
    </record>

    <!-- Assistants cannot view financial details of members -->
    <record id="rule_assistant_no_financial_details" model="ir.rule">
        <field name="name">Assistant No Financial Details</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="domain_force">[('customer_rank', '!=', 1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="groups" eval="[(4, ref('group_library_assistant'))]"/>
    </record>
</odoo>
