<odoo>
    <record id="customer_details" model="ir.rule">
        <field name="name">Customer details</field>
        <field name="model_id" ref="res.partner"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
