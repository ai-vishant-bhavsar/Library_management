<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="external_layout_standard" inherit_id="web.external_layout_standard">
        <xpath expr="//div[1]" position="replace">
            <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
                <!--Company Logo-->
                <div class="row mb8">
                    <div class="col-12">
                        <div class="d-flex justify-content-start">
                            <img t-if="company.logo"
                                 t-att-src="image_data_uri(company.logo)"
                                 style="max-height:40px;max-width:140%"
                                 alt="Logo"/>
                        </div>
                        <div class="col-9 text-end"
                             style="margin-top:22px;"
                             t-if="company.report_header"
                             t-field="company.report_header"
                             name="moto">Company tagline
                        </div>
                    </div>
                </div>
                <!--Company Address-->
                <div class="row">
                    <div class="col-12" name="company_address">
                        <div class="d-flex justify-content-end"
                             style="text-align: right;">
                            <ul class="list-unstyled" name="company_address_list">
                                <li t-if="company.is_company_details_empty">
                                    <span t-field="company.partner_id"
                                          t-options='{"widget": "contact", "fields": ["address", "email", "phone"], "no_marker": true}'>
                                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                            <strong>Company address block</strong>
                                            <div>Contains the company address.</div>
                                        </div>
                                    </span>
                                </li>
                                <li t-else="">
                                    <span t-field="company.company_details">
                                        <div class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 w-100 opacity-75 text-muted text-center">
                                            <strong>Company details block</strong>
                                            <div>Contains the company details.</div>
                                        </div>
                                    </span>
                                </li>
                                <li t-if="not forced_vat"/>
                                <li t-else="">
                                    <t t-out="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                                    <span t-out="forced_vat">US12345671</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <!--Header Border-->
                <div t-if="company.logo or company.report_header"
                     class="row zero_min_height">
                    <div class="col-12">
                        <div style="border-bottom: 2px solid black;"/>
                    </div>
                </div>
            </div>
            <!-- Footer -->
            <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
                <ul style="display: inline">
                    <div class="text-start" style="border-top: 1px solid black;">
                        <t t-out="company.email"/>
                    </div>
                    <div class="text-end">
                        Page:
                        <span class="page"/>/
                        <span class="topage"/>
                    </div>
                </ul>
            </div>
        </xpath>
    </template>
    <template id="library_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <t t-foreach="docs" t-as="record">
                        <h3 class="text-left">
                            <span>
                                <t t-out="record.name"/>
                                <span>#</span>
                                <t t-out="[record.id]"/>
                            </span>
                            <br/>
                        </h3>
                        <div class="row mb-4" id="information">
                            <div class="col">
                                <strong>Library Name</strong>
                                <div t-field="record.name">Library Name</div>
                            </div>
                            <div class="col">
                                <strong>Opening Date</strong>
                                <div t-field="record.date">Opening Date</div>
                            </div>
                            <div class="col">
                                <strong>Library Location</strong>
                                <div t-field="record.location">Library Location</div>
                            </div>
                            <div class="col">
                                <strong>Borrowed book count</strong>
                                <div t-field="record.borrowed_book_count">Library borrowed book count</div>
                            </div>
                        </div>
                    </t>
                    <!-- Report Table -->
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Book Title</th>
                                <th class="text-end">Price</th>
                                <th class="text-end">Publish date</th>
                                <th class="text-end">Author</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="record">
                                <t t-foreach="record.book_ids" t-as="book">
                                    <tr>
                                        <td>
                                            <span>
                                                <t t-out="book.name"/>
                                            </span>
                                            <br/>
                                            <span>
                                                <t t-out="book.qty_available"/>
                                            </span>
                                            <br/>
                                        </td>
                                        <td class="text-end">
                                            <span>
                                                <t t-out="book.list_price"/>
                                            </span>
                                            <br/>
                                        </td>
                                        <td class="text-end">
                                            <span>
                                                <t t-out="book.published_date"/>
                                            </span>
                                            <br/>
                                        </td>
                                        <td class="text-end">
                                            <span>
                                                <t t-out="book.author"/>
                                            </span>
                                            <br/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
