<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="library_report_template">
        <!-- Inheriting Odoo's default report layout -->
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=lang)"/>
                <t t-set="company" t-value="doc.company_id"/>

                <!-- Header Section -->
                <div class="header" style="display: flex; justify-content: space-between; align-items: center;">
                    <!-- Left: Company Logo & Address -->
                    <div>
                        <img t-att-src="'/web/image/res.company/%s/logo' % company.id" style="max-height: 60px;"/>
                        <p>
                            <strong t-out="company.name"/>
                        </p>
                        <p t-out="company.street or ''"/>
                        <p t-out="company.city or ''"/>,
                        <p t-out="company.state_id.name or ''"/>
                        <p t-out="company.country_id.name or ''"/>
                        <p t-out="company.phone or ''"/>
                        <p t-out="company.email or ''"/>
                    </div>

                    <!-- Right: Company Details -->
                    <div style="text-align: right;">
                        <p>
                            <strong>Company Address:</strong>
                            <t t-out="company.street or ''"/>,
                            <t t-out="company.city or ''"/>
                        </p>
                        <p>
                            <strong>Email:</strong>
                            <t t-out="company.email or ''"/>
                        </p>
                        <p>
                            <strong>Phone:</strong>
                            <t t-out="company.phone or ''"/>
                        </p>
                    </div>
                </div>

                <!-- Report Title -->
                <h2 style="text-align: center;">Library Report</h2>

                <!-- Library Information -->
                <table class="table">
                    <tbody>
                        <tr>
                            <td>
                                <strong>Library Name #</strong>
                                <t t-out="doc.name"/>
                                #
                                <t t-out="doc.id"/>
                            </td>
                            <td>
                                <strong>Librarian Name:</strong>
                                <t t-out="doc.librarian_id.name or 'N/A'"/>
                            </td>
                            <td>
                                <strong>Date:</strong>
                                <t t-out="format_date(doc.date, date_format='dd/MMM/yyyy')"/>
                            </td>
                            <td>
                                <strong>Total Borrowed Books Count:</strong>
                                <t t-out="doc.borrowed_book_count"/>
                            </td>
                            <td>
                                <strong>Location:</strong>
                                <t t-out="doc.location or 'N/A'"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!-- Book Details Table -->
                <h3>Book Details</h3>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Book ISBN</th>
                            <th>Book Name</th>
                            <th>On Hand</th>
                            <th>Price</th>
                            <th>Published Date</th>
                            <th>Author</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.book_ids" t-as="book">
                            <td t-out="book.barcode or '-'"/>
                            <td t-out="book.name"/>
                            <td t-out="book.qty_available"/>
                            <td t-out="book.list_price"/>
                            <td t-out="format_date(book.date, date_format='dd/MMM/yyyy')"/>
                            <td t-out="book.author_id.name or '-'"/>
                        </tr>
                    </tbody>
                </table>

                <!-- Notes Section -->
                <p>
                    <strong>Note:</strong>
                    <t t-out="doc.notes or 'No additional notes'"/>
                </p>

                <!-- Custom Footer -->
                <div class="footer" style="display: flex; justify-content: space-between; width: 100%;">
                    <!-- Left: Company Website -->
                    <div>
                        <span t-out="company.website or ''"/>
                    </div>

                    <!-- Right: Page Number -->
                    <div>
                        <span>Page
                            <span class="page"/>
                            /
                            <span class="topage"/>
                        </span>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
