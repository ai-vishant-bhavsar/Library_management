<odoo>
    <!--customize base external layout-->
    <template id="library_external_layout" inherit_id="web.external_layout_standard">
        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="t-if">doc</attribute>
        </xpath>
        <xpath expr="//img" position="attributes">
            <attribute name="style">width:200px;height:600px</attribute>
        </xpath>
        <xpath expr="//img" position="after">
            <ul class="list-unstyled" name="company_address_list">
                <li>
                    <span t-field="company.partner_id"
                          t-options='{"widget": "contact", "fields": ["address", "email", "phone"], "no_marker": true}'>
                    </span>
                </li>
            </ul>
        </xpath>
        <xpath expr="//div[@t-field='company.report_footer']" position="attributes">
            <attribute name="t-if">not doc</attribute>
        </xpath>
        <xpath expr="//div[@t-field='company.report_footer']" position="inside">
            <div id="website_footer" class="flex-grow-1 text-start me-2">
                <span t-out="company.website"/>
            </div>
        </xpath>
    </template>
    <!-- Library member report -->
    <template id="library_member_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure"/>
                    <t t-foreach="docs" t-as="record">
                        <div class="row mb-4" id="information">
                            <div class="col">
                                <strong>Membership ID</strong>
                                <div t-field="record.membership_no">Membership ID</div>
                            </div>
                            <div class="col">
                                <strong>Member Name</strong>
                                <div t-field="record.name">Member name</div>
                            </div>
                            <div class="col">
                                <strong>Membership date</strong>
                                <div t-field="record.membership_date">Membership date</div>
                            </div>
                            <div class="col">
                                <strong>Phone number</strong>
                                <div t-field="record.phone">Phone number</div>
                            </div>
                            <div class="col">
                                <strong>Email</strong>
                                <div t-field="record.email">Email</div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>