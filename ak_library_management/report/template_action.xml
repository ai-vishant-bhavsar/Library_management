<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_library_report" model="ir.actions.report">
            <field name="name">Library Report</field>
            <field name="model">library</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ak_library_management.library_report_template</field>
            <field name="report_file">ak_library_management.library_report_template</field>
            <field name="binding_model_id" ref="model_library"/>
            <field name="print_report_name">'Library report'</field>
            <field name="binding_type">report</field>
        </record>
        <!--library member report action-->
        <record id="action_report_library_member" model="ir.actions.report">
            <field name="name">Member Report</field>
            <field name="model">library.member</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ak_library_management.library_member_report_template</field>
            <field name="report_file">ak_library_management.library_member_report_template</field>
            <field name="print_report_name">'Library Member Report'</field>
            <field name="binding_model_id" ref="model_library_member"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
